{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"description": "Personal portfolio of César Peón (cpl121) — full-stack developer specialized in Web3, VR/3D and OTT",
	"homepage": "https://cpl121.eth.limo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cpl121/portfolio.git"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"verify:build": "node scripts/verify-build.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.1",
		"@types/three": "^0.186.0",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.28",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.0.0",
		"sass": "^1.104.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"three": "^0.186.0"
	}
}
