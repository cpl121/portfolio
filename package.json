{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"description": "Personal portfolio of César Peón (cpl121) — full-stack developer specialized in Web3, VR/3D and OTT",
	"homepage": "https://cpl121.eth.limo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cpl121/portfolio.git"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"verify:build": "node scripts/verify-build.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.6",
		"@sveltejs/vite-plugin-svelte": "^7.1.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.0",
		"@types/three": "^0.185.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.4.49",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.0.0",
		"sass": "^1.83.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.1.1",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.19.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"three": "^0.185.1"
	}
}
